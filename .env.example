USAGE_DB_PASSWORD=change-this-database-password
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
USAGE_ENCRYPTION_KEY=change-this-fernet-key
USAGE_BACKUP_INTERVAL_SECONDS=86400
# Seals the database dumps before they touch disk or S3 (openssl aes-256-cbc).
# Generate with: openssl rand -base64 32
# Keep it AND the Fernet key in the password manager: a backup needs the
# passphrase to open and the Fernet key to read.
USAGE_BACKUP_PASSPHRASE=change-this-backup-passphrase
# Public URL of the app, used in the magic-link emails (no trailing slash)
USAGE_BASE_URL=
# Development conveniences: show sign-in links in API responses, plain-http cookies.
# Production: false / true
USAGE_DEV_AUTH_LINKS=true
USAGE_COOKIE_SECURE=false
# Host bindings of the blue/green app containers.
# Production binds loopback only: 127.0.0.1:8063 and 127.0.0.1:8064
USAGE_BLUE_BIND=8063
USAGE_GREEN_BIND=8064
# Amazon SES SMTP credentials for the magic-link emails
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=change-this-ses-username
SES_SMTP_PASSWORD=change-this-ses-password
SES_SENDER_EMAIL=no-reply@example.com

# S3 backup of the sealed database dumps (our-stories pattern:
# daily/usage/<date>/ + monthly/ on the 1st); empty disables it
S3_BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2

# Anthropic key for reading meter values from photos; empty disables photo extraction
ANTHROPIC_API_KEY=
USAGE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
